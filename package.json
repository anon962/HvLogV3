{
    "version": "1.0.0",
    "main": "index.ts",
    "scripts": {
        "dev": "npm-watch",
        "dev-userscript": "vite build --mode development --config vite.config.ts",
        "dev-ui": "vite build --mode development --config vite.config.ui.ts",
        "build": "vite build",
        "serve": "python3 -m http.server --directory dist/userscript 5648",
        "test": "vitest"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "@types/react": "^19.0.12",
        "@types/react-dom": "^19.0.4",
        "npm-watch": "^0.13.0",
        "radash": "^12.1.0",
        "ts-json-schema-generator": "^2.3.0",
        "vite": "^6.2.2",
        "vite-plugin-monkey": "^5.0.8",
        "vite-plugin-singlefile": "^2.2.0",
        "vitest": "^3.0.9"
    },
    "type": "module",
    "dependencies": {
        "@mongodb-js/zstd": "^2.0.1",
        "@observablehq/plot": "^0.6.17",
        "@radix-ui/react-scroll-area": "^1.2.3",
        "@radix-ui/react-tabs": "^1.1.3",
        "@tailwindcss/vite": "^4.0.15",
        "@vitejs/plugin-react": "^4.3.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "idb": "^8.0.2",
        "lucide-react": "^0.483.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-resizable-panels": "^2.1.7",
        "tailwind-merge": "^3.0.2",
        "tailwindcss": "^4.0.15",
        "tw-animate-css": "^1.2.4"
    },
    "watch": {
        "dev-userscript": {
            "patterns": [
                "src",
                "dist/ui",
                "vite.config.ts",
                "vite.config.ui.ts"
            ],
            "extensions": "html,css,js,ts,tsx",
            "verbose": true
        },
        "dev-ui": {
            "patterns": [
                "src",
                "vite.config.ui.ts"
            ],
            "extensions": "html,css,js,ts,tsx",
            "verbose": true
        }
    }
}
